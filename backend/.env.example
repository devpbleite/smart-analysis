# Variáveis de ambiente — copie este arquivo para .env e preencha os valores

# String de conexão do NeonDB (PostgreSQL)
# Formato: postgresql://usuario:senha@host.neon.tech/banco?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/banco?sslmode=require"

# Chave de API do Groq (obter em: https://console.groq.com/keys)
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Configurações opcionais (valores padrão já definidos em settings.py) ---

# Modelo do LLM. Opções Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# LLM_MODEL="llama-3.3-70b-versatile"

# Temperatura do LLM (0 = determinístico, ideal para dados)
# LLM_TEMPERATURE="0"

# Linhas de exemplo da tabela enviadas ao LLM (reduzir economiza tokens)
# DB_SAMPLE_ROWS="1"

# Máximo de iterações do agente por pergunta (evita loops)
# AGENT_MAX_ITERATIONS="10"

# Mostrar raciocínio do agente no terminal (true/false)
# AGENT_VERBOSE="true"
